---
import Portfolio from '../layouts/Portfolio.astro';
import MediaSlot from '../components/MediaSlot.astro';
import editorial from '../data/editorial.json';
---
<Portfolio title="About" description="Ethan Bai - Game Design Student at the University of Southern California." page="about">
  <div class="wrap">
    <div class="about-layout about-introduction">
      <MediaSlot id="ABOUT-01" label="Personal photo" />
      <article class="about-copy prose" aria-labelledby="about-name">
        <header><p class="role">Game Design Student</p><h1 id="about-name">Ethan Bai</h1></header>
        {editorial.about.map(paragraph => {
          const label = 'Audio page';
          const position = paragraph.indexOf(label);
          return <p>{position < 0 ? paragraph : <>{paragraph.slice(0, position)}<a class="text-link prose-link" href="/audio/">{label} <span aria-hidden="true">↗</span></a>{paragraph.slice(position + label.length)}</>}</p>;
        })}
        <div class="inline-links"><a class="text-link" href="/resume/">Resume <span aria-hidden="true">↗</span></a></div>
      </article>
    </div>
    <section class="contact-section" id="contact" aria-labelledby="contact-title"><h2 id="contact-title" class="category-heading">Contact</h2><dl class="contact-list"><div><dt>Email</dt><dd><a href="mailto:ethanbaiyucong@gmail.com">ethanbaiyucong@gmail.com</a></dd></div><div><dt>LinkedIn</dt><dd><a href="https://www.linkedin.com/in/ethanbai/" target="_blank" rel="noopener noreferrer">linkedin.com/in/ethanbai <span aria-hidden="true">↗</span></a></dd></div></dl></section>
  </div>
</Portfolio>
