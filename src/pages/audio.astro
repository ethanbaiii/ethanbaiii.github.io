---
import Portfolio from '../layouts/Portfolio.astro';
import MediaSlot from '../components/MediaSlot.astro';
import MusicTrack from '../components/MusicTrack.astro';
import media from '../data/media.json';
import editorial from '../data/editorial.json';
const { overdawn, music } = editorial;
const introduction = "Game sound design and original music.";
---
<Portfolio title="Audio" description={introduction} page="audio">
  <div class="wrap">
    <header class="collection-intro standalone-intro"><h1>Audio</h1><p>{introduction}</p></header>
    <section id="game-audio" class="audio-section" aria-labelledby="game-audio-title">
      <h2 id="game-audio-title" class="category-heading">Game Audio</h2>
      <article class="work-item audio-case audio-listing" aria-labelledby="overdawn-title">
        <MediaSlot id="OVERDAWN-COVER" label="Overdawn project preview" />
        <div class="work-copy">
          <header><p class="role">{overdawn.role}</p><h3 id="overdawn-title"><a class="title-link" href={overdawn.href}>{overdawn.title}</a></h3><p class="project-meta">{overdawn.meta}</p></header>
          <div class="prose audio-prose">{overdawn.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
          <a class="text-link" href={overdawn.href}>View Audio Case Study <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </section>
    <section id="music" class="audio-section" aria-labelledby="music-title">
      <h2 id="music-title" class="category-heading">Music</h2>
      <div class="music-list">{music.map(track => <article class="music-track" aria-labelledby={`track-${track.order}-title`}>
        <header><h3 id={`track-${track.order}-title`}>{track.title}</h3>
        <p class="project-meta">{track.genre}</p></header>
        <MusicTrack id={`MUSIC-0${track.order}`} title={track.title} src={media.items[`MUSIC-0${track.order}`].src} duration={media.items[`MUSIC-0${track.order}`].duration} />
      </article>)}</div>
    </section>
  </div>
</Portfolio>
