---
import Portfolio from '../layouts/Portfolio.astro';
const resumeSrc = '/resume/ethan-bai-resume.pdf';
---
<Portfolio title="Resume" description="View or download Ethan Bai's English resume." page="resume">
  <div class="wrap">
    <header class="collection-intro standalone-intro"><h1>Resume</h1></header>
    <section class="resume-section" aria-label="Resume document">
      <div class="resume-toolbar">
        <a class="download-button" href={resumeSrc} download="Ethan-Bai-Resume.pdf">Download PDF <span aria-hidden="true">↓</span></a>
      </div>
      <iframe class="resume-preview" src={resumeSrc + '#view=FitH'} title="Ethan Bai - English resume" loading="lazy"></iframe>
      <a class="text-link" href={resumeSrc} target="_blank" rel="noopener noreferrer">Open PDF <span aria-hidden="true">↗</span></a>
    </section>
    <div class="inline-links"><a class="text-link" href="/#work">Browse selected work <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/#contact">Contact <span aria-hidden="true">↗</span></a></div>
  </div>
</Portfolio>
