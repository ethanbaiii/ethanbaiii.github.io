---
import '../styles/typography.css';
import '../styles/localization.css';
import '../styles/portfolio.css';
import '../styles/media.css';
import '../styles/music-player.css';
import { ClientRouter } from 'astro:transitions';
import MusicPlayer from '../components/MusicPlayer.astro';
import DitherBackground from '../components/DitherBackground.astro';
import OpeningIntro from '../components/OpeningIntro.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import {localeFromPath,localizedPath,englishLabel} from '../lib/i18n';
interface Props { title: string; description: string; page?: 'home' | 'case' | 'prototypes' | 'analysis' | 'audio' | 'about' | 'resume' | 'not-found' }
const { title, description, page = 'home' } = Astro.props;
const locale=localeFromPath(Astro.url.pathname);
const zh=locale==='zh';
const text=(en:string,cn:string)=>zh?cn:en;
const href=(path:string)=>localizedPath(path,locale);
const label=(en:string,cn:string,path:string)=>text(en,cn)+englishLabel(path,locale);
---
<!doctype html>
<html lang={zh ? "zh-CN" : "en"} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        if (window.__portfolioLanguageChecked) return;
        window.__portfolioLanguageChecked = true;
        const forced = new URLSearchParams(location.search).get('lang');
        if (forced === 'en' || forced === 'zh') {
          try { localStorage.setItem('portfolio-language', forced); } catch {}
        }
        if (location.pathname !== '/') return;
        let saved;
        try { saved = localStorage.getItem('portfolio-language'); } catch {}
        const choice = forced === 'en' || forced === 'zh' ? forced : saved === 'en' || saved === 'zh' ? saved : ((navigator.languages?.[0] || navigator.language).toLowerCase().startsWith('zh') ? 'zh' : 'en');
        if (choice === 'zh') location.replace('/zh/' + location.search + location.hash);
      })();
    </script>
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>
      (() => {
        if (window.__portfolioIntroDocument) return;
        window.__portfolioIntroDocument = true;
        if (!['/', '/zh/'].includes(location.pathname) || location.hash || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.dataset.intro = 'pending';
        // If the animation bundle cannot load, the site still becomes usable.
        window.setTimeout(() => {
          if (!document.documentElement.hasAttribute('data-intro')) return;
          document.dispatchEvent(new Event('portfolio:intro-timeout'));
          document.documentElement.removeAttribute('data-intro');
          document.querySelectorAll('[data-intro-inert]').forEach(element => {
            element.inert = false;
            element.removeAttribute('data-intro-inert');
          });
          const intro = document.querySelector('site-intro');
          if (intro) intro.hidden = true;
        }, 4500);
      })();
    </script>
    <style is:inline>
      html[data-intro="pending"],
      html[data-intro="pending"] body { background: #1b2025; }
      html[data-intro="pending"] dither-background { visibility: hidden; }
      html[data-intro="pending"] [data-intro-content],
      html[data-intro="playing"] [data-intro-content],
      html[data-intro="pending"] dither-background canvas,
      html[data-intro="playing"] dither-background canvas { visibility: hidden; }
      @media (prefers-reduced-motion: reduce) {
        html[data-intro] [data-intro-content] { visibility: visible; }
      }
    </style>
    <ClientRouter fallback="swap" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <title>{title} - Ethan Bai</title>
  </head>
  <body class={`portfolio ${page}`}>
    <DitherBackground />
    {page === 'home' && <OpeningIntro />}
    <a class="skip-link" href="#main" data-intro-content>{text('Skip to content','跳至正文')}</a>
    <header class="header wrap" data-intro-content>
      <a class="wordmark" href={href('/')} aria-label={text('Ethan Bai homepage','Ethan Bai 首页')}>Ethan Bai<span aria-hidden="true">.</span></a>
      <nav class="primary-nav" aria-label={text('Main navigation','主导航')}>
        <a class={page === 'home' || page === 'case' ? 'current' : undefined} href={href('/#work')} aria-current={page === 'home' ? 'location' : undefined}>{text('Selected Work','精选作品')}</a>
        <a class={page === 'prototypes' ? 'current' : undefined} href={href('/prototypes/')} aria-current={page === 'prototypes' ? 'page' : undefined}>{label('More Work','更多作品','/prototypes/')}</a>
        <a class={page === 'analysis' ? 'current' : undefined} href={href('/analysis/')} aria-current={page === 'analysis' ? 'page' : undefined}>{label('Analysis','设计分析','/analysis/')}</a>
        <a class={page === 'audio' ? 'current' : undefined} href={href('/audio/')} aria-current={page === 'audio' ? 'page' : undefined}>{label('Audio','音频','/audio/')}</a>
        <a class={page === 'about' ? 'current' : undefined} href={href('/about/')} aria-current={page === 'about' ? 'page' : undefined}>{text('About','关于我')}</a>
        <a class={page === 'resume' ? 'current' : undefined} href={href('/resume/')} aria-current={page === 'resume' ? 'page' : undefined}>{label('Resume','简历','/resume/')}</a>
      </nav>
      <LanguageSwitch />
    </header>
    <main id="main" tabindex="-1" data-intro-content><slot /></main>
    <footer class="footer wrap" data-intro-content>
      <div><a class="wordmark" href={href('/')}>Ethan Bai<span aria-hidden="true">.</span></a><p>{text('Game Design Student','游戏设计学生')}</p></div>
      <div class="footer-actions"><a href={href('/about/#contact')}>{text('Contact','联系方式')} <span aria-hidden="true">↗</span></a><a href={href('/resume/')}>{label('Resume','简历','/resume/')} <span aria-hidden="true">↗</span></a><button type="button" data-background-toggle hidden>Pause background</button></div>
      <span class="footer-year">2026</span>
    </footer>
    <MusicPlayer />
    <script>
      import '../scripts/media-playback';
      import '../scripts/language';
    </script>
  </body>
</html>
