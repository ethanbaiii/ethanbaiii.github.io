---
import '../styles/portfolio.css';
import '../styles/media.css';
import '../styles/music-player.css';
import { ClientRouter } from 'astro:transitions';
import MusicPlayer from '../components/MusicPlayer.astro';
import DitherBackground from '../components/DitherBackground.astro';
import OpeningIntro from '../components/OpeningIntro.astro';
interface Props { title: string; description: string; page?: 'home' | 'case' | 'prototypes' | 'analysis' | 'audio' | 'about' | 'resume' | 'not-found' }
const { title, description, page = 'home' } = Astro.props;
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <script is:inline>
      (() => {
        if (window.__portfolioIntroDocument) return;
        window.__portfolioIntroDocument = true;
        if (location.pathname !== '/' || location.hash || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.dataset.intro = 'pending';
        // If the animation bundle cannot load, the site still becomes usable.
        window.setTimeout(() => {
          if (!document.documentElement.hasAttribute('data-intro')) return;
          document.dispatchEvent(new Event('portfolio:intro-timeout'));
          document.documentElement.removeAttribute('data-intro');
          document.querySelectorAll('[data-intro-inert]').forEach(element => {
            element.inert = false;
            element.removeAttribute('data-intro-inert');
          });
          const intro = document.querySelector('site-intro');
          if (intro) intro.hidden = true;
        }, 4500);
      })();
    </script>
    <style is:inline>
      html[data-intro="pending"],
      html[data-intro="pending"] body { background: #1b2025; }
      html[data-intro="pending"] dither-background { visibility: hidden; }
      html[data-intro="pending"] [data-intro-content],
      html[data-intro="playing"] [data-intro-content],
      html[data-intro="pending"] dither-background canvas,
      html[data-intro="playing"] dither-background canvas { visibility: hidden; }
      @media (prefers-reduced-motion: reduce) {
        html[data-intro] [data-intro-content] { visibility: visible; }
      }
    </style>
    <ClientRouter fallback="swap" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <title>{title} - Ethan Bai</title>
  </head>
  <body class={`portfolio ${page}`}>
    <DitherBackground />
    {page === 'home' && <OpeningIntro />}
    <a class="skip-link" href="#main" data-intro-content>Skip to content</a>
    <header class="header wrap" data-intro-content>
      <a class="wordmark" href="/" aria-label="Ethan Bai homepage">Ethan Bai<span aria-hidden="true">.</span></a>
      <nav class="primary-nav" aria-label="Main navigation">
        <a class={page === 'home' || page === 'case' ? 'current' : undefined} href="/#work" aria-current={page === 'home' ? 'location' : undefined}>Selected Work</a>
        <a class={page === 'prototypes' ? 'current' : undefined} href="/prototypes/" aria-current={page === 'prototypes' ? 'page' : undefined}>More Work</a>
        <a class={page === 'analysis' ? 'current' : undefined} href="/analysis/" aria-current={page === 'analysis' ? 'page' : undefined}>Analysis</a>
        <a class={page === 'audio' ? 'current' : undefined} href="/audio/" aria-current={page === 'audio' ? 'page' : undefined}>Audio</a>
        <a class={page === 'about' ? 'current' : undefined} href="/about/" aria-current={page === 'about' ? 'page' : undefined}>About</a>
        <a class={page === 'resume' ? 'current' : undefined} href="/resume/" aria-current={page === 'resume' ? 'page' : undefined}>Resume</a>
      </nav>
      <button class="language-placeholder" type="button" disabled aria-label="Language selection: English; Chinese coming later" title="Language switching will be added later">
        <span lang="en" class="language-current">EN</span><span aria-hidden="true">/</span><span lang="zh-CN">中文</span>
      </button>
    </header>
    <main id="main" tabindex="-1" data-intro-content><slot /></main>
    <footer class="footer wrap" data-intro-content>
      <div><a class="wordmark" href="/">Ethan Bai<span aria-hidden="true">.</span></a><p>Game Design Student</p></div>
      <div class="footer-actions"><a href="/about/#contact">Contact <span aria-hidden="true">↗</span></a><a href="/resume/">Resume <span aria-hidden="true">↗</span></a><button type="button" data-background-toggle hidden>Pause background</button></div>
      <span class="footer-year">2026</span>
    </footer>
    <MusicPlayer />
    <script>
      import '../scripts/media-playback';
    </script>
  </body>
</html>
