---
import PlayPauseIcon from './PlayPauseIcon.astro';
interface Props { id: string; title: string; src: string; duration: number }
const { id, title, src, duration } = Astro.props;
const zh=Astro.url.pathname.startsWith('/zh/');
const displayTitle=zh&&id==='MUSIC-05'?'月光下的小憩':title;
const formatTime = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
---
<div class="media-frame media-audio media-ready" data-media-slot={id} data-media-state="ready" data-media-kind="audio">
  <div class="music-controls" data-music-track={id} data-title={title} data-src={src} data-duration={duration}>
    <button type="button" class="music-play-button" data-music-toggle aria-label={`${zh?'播放':'Play'} ${displayTitle}`} aria-pressed="false"><PlayPauseIcon /></button>
    <input type="range" min="0" max={duration} step="0.1" value="0" data-music-seek aria-label={`${zh?'调整播放进度：':'Seek '}${displayTitle}`} disabled />
    <span class="music-time" data-music-time>0:00 / {formatTime(duration)}</span>
  </div>
</div>
