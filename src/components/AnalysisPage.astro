---
import Portfolio from '../layouts/Portfolio.astro';
import MediaSlot from './MediaSlot.astro';
import { analyses as englishAnalyses } from '../data/analysis';
import { moreWork } from '../data/current';
import copy from '../data/zh.json';
import {localeFromPath,localizedPath} from '../lib/i18n';
const locale=localeFromPath(Astro.url.pathname),zh=locale==='zh';
const text=(en:string,cn:string)=>zh?cn:en;
const href=(path:string)=>localizedPath(path,locale);
const analyses=englishAnalyses.map(item=>({...item,...(zh?copy.analyses.find(c=>c.id===item.id):{}),href:href(item.href)}));
const intro=zh?copy.moreWork[1].description:moreWork[1].description;
---
<Portfolio title={text("Analysis","设计分析")} description={intro} page="analysis">
  <div class="wrap">
    <a class="back-link" href={href("/#work")}><span aria-hidden="true">←</span> {text("Selected Work","精选作品")}</a>
    <header class="collection-intro"><h1>{text("Analysis","设计分析")}</h1><p>{intro}</p></header>
    <div class="summary-collection">{analyses.map(analysis => <article id={analysis.id} aria-labelledby={`${analysis.id}-title`}>
      <header><h2 id={`${analysis.id}-title`}><a class="title-link" href={analysis.href}>{analysis.title}</a></h2><p class="project-meta">{analysis.meta}</p></header>
      <div class="summary-layout"><MediaSlot id={analysis.mediaId} label={analysis.mediaLabel} /><div class="prose">{analysis.paragraphs.map(paragraph => <p>{paragraph}</p>)}<a class="text-link" href={analysis.href}>{text("Read the Analysis","阅读分析")} <span aria-hidden="true">↗</span></a></div></div>
    </article>)}</div>
    <div class="collection-end"><a class="text-link" href={href("/#work")}><span aria-hidden="true">←</span> {text("Back to selected work","返回精选作品")}</a><a class="text-link" href="#main">{text("Back to top","返回顶部")} <span aria-hidden="true">↑</span></a></div>
  </div>
</Portfolio>
