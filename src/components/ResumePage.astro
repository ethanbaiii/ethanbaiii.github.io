---
import Portfolio from '../layouts/Portfolio.astro';
import {localeFromPath,localizedPath} from '../lib/i18n';
const locale=localeFromPath(Astro.url.pathname),zh=locale==='zh';
const text=(en:string,cn:string)=>zh?cn:en;
const href=(path:string)=>localizedPath(path,locale);
const resumeSrc = '/resume/ethan-bai-resume.pdf';
---
<Portfolio title={text("Resume","简历")} description={text("View or download Ethan Bai's English resume.","在线查看或下载 Ethan Bai 的英文简历。")} page="resume">
  <div class="wrap">
    <header class="collection-intro standalone-intro"><h1>{text("Resume","简历")}</h1>{zh&&<p>当前提供英文版简历，可在线查看或下载。</p>}</header>
    <section class="resume-section" aria-label={text("Resume document","英文简历")}>
      <div class="resume-toolbar">
        <a class="download-button" href={resumeSrc} download="Ethan-Bai-Resume.pdf">{text("Download PDF","下载英文简历 PDF")} <span aria-hidden="true">↓</span></a>
      </div>
      <iframe class="resume-preview" src={resumeSrc + '#view=FitH'} title={text("Ethan Bai - English resume","Ethan Bai - 英文简历")} loading="lazy"></iframe>
      <a class="text-link" href={resumeSrc} target="_blank" rel="noopener noreferrer">{text("Open PDF","打开英文简历 PDF")} <span aria-hidden="true">↗</span></a>
    </section>
    <div class="inline-links"><a class="text-link" href={href("/#work")}>{text("Browse selected work","浏览精选作品")} <span aria-hidden="true">↗</span></a><a class="text-link" href={href("/about/#contact")}>{text("Contact","联系方式")} <span aria-hidden="true">↗</span></a></div>
  </div>
</Portfolio>
