---
import Portfolio from '../layouts/Portfolio.astro';
import MediaSlot from './MediaSlot.astro';
import editorial from '../data/editorial.json';
import copy from '../data/zh.json';
import {localeFromPath,localizedPath,englishLabel} from '../lib/i18n';
const locale=localeFromPath(Astro.url.pathname), zh=locale==='zh';
const text=(en:string,cn:string)=>zh?cn:en;
const href=(path:string)=>localizedPath(path,locale);
const contentLinks=[
  {label:text('Audio page','音频页面'),href:href('/audio/'),external:false},
  {label:text('Bilibili','B站'),href:copy.bilibiliUrl,external:true},
];
---
<Portfolio title={text('About','关于我')} description={text('Ethan Bai - Game Design Student at the University of Southern California.','白宇璁 Ethan Bai，南加州大学游戏设计学生。')} page="about">
  <div class="wrap">
    <div class="about-layout about-introduction">
      <MediaSlot id="ABOUT-01" label={text('Personal photo','个人照片')} />
      <article class="about-copy prose" aria-labelledby="about-name">
        <header><h1 id="about-name">{text('Ethan Bai','白宇璁 Ethan Bai')}</h1></header>
        {(zh?copy.about:editorial.about).map(paragraph => <p>{paragraph.split(/(Audio page|音频页面|Bilibili|B站)/).map(part => {
          const link=contentLinks.find(link=>link.label===part);
          return link ? <a class="text-link prose-link" href={link.href} target={link.external?'_blank':undefined} rel={link.external?'noopener noreferrer':undefined}>{part}{!link.external&&englishLabel(link.href,locale)} <span aria-hidden="true">↗</span></a> : part;
        })}</p>)}
        <div class="inline-links"><a class="text-link" href={href('/resume/')}>{text('Resume','简历')}{englishLabel('/resume/',locale)} <span aria-hidden="true">↗</span></a></div>
      </article>
    </div>
    <section class="contact-section" id="contact" aria-labelledby="contact-title"><h2 id="contact-title" class="category-heading">{text('Contact','联系方式')}</h2><dl class="contact-list"><div><dt>{text('Email','邮箱')}</dt><dd><a href="mailto:ethanbaiyucong@gmail.com">ethanbaiyucong@gmail.com</a></dd></div><div><dt>LinkedIn</dt><dd><a href="https://www.linkedin.com/in/ethanbai/" target="_blank" rel="noopener noreferrer">linkedin.com/in/ethanbai <span aria-hidden="true">↗</span></a></dd></div></dl></section>
  </div>
</Portfolio>
